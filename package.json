{
  "name": "slack-tools",
  "type": "module",
  "version": "1.2.0",
  "description": "AI SDK tools for Slack",
  "packageManager": "pnpm@10.27.0",
  "author": "malewis5",
  "license": "MIT",
  "homepage": "https://github.com/malewis5/slack-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malewis5/slack-tools.git"
  },
  "bugs": {
    "url": "https://github.com/malewis5/slack-tools/issues"
  },
  "keywords": [
    "slack",
    "ai-sdk",
    "ai",
    "tools",
    "vercel",
    "agent",
    "mcp",
    "chatbot"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "tsx generate.ts",
    "typecheck": "tsc --noEmit",
    "attw": "attw --pack .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@ai-sdk/mcp": "^1.0.36",
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.0",
    "bumpp": "^10.4.1",
    "dotenv": "^17.4.2",
    "tsdown": "0.21.0-beta.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@slack/web-api": "^7.15.1",
    "ai": "^6.0.168",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "ai": ">=6.0.0",
    "zod": ">=4.0.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": false
    },
    "zod": {
      "optional": false
    }
  }
}
